# Copy this file to .env and fill in what you need. Everything is optional for solo play.
# Values that start with VITE_ are baked into the page and are public. Never put a secret in one.

# ---------- Online co-op (story and Survival rooms) ----------
# Friends first try to connect straight to each other (WebRTC). When their networks do not allow that,
# the game falls back to an online relay on its own. Without a relay, co-op only works on the same Wi-Fi
# or between two "friendly" home networks.
#
# While you run `bun run dev` you need nothing here: the dev server carries the relay itself, so anyone
# who opens your preview link or tunnel address can join.
#
# For a built and deployed page, point it at a relay you run (see "Play online" in README.md):
#   - Cloudflare Worker:   bun run relay:deploy      then use the address it prints
#   - anywhere with Bun:   bun run relay             (Render, Fly, Railway, a small VPS, Docker)
# Several addresses can be listed, separated by commas; the first one that answers is used.
VITE_RELAY_URL=
# Example: VITE_RELAY_URL=wss://zombie-outbreak-relay.yourname.workers.dev/relay

# Optional extra: a TURN server lets WebRTC itself get through strict networks (a little less delay than
# the relay). Either a free Metered.ca account...
VITE_METERED_APP=
VITE_METERED_KEY=
# ...or any other TURN provider.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---------- Co-op server (Endless Descent) ----------
# Address of a co-op server hosted elsewhere, for example wss://your-server.example/coop
# Leave empty to use the one that starts with `bun run dev`. A hosted co-op server also carries the relay,
# so VITE_RELAY_URL can stay empty when this is set.
VITE_COOP_URL=
# Port of the co-op server (server side).
COOP_PORT=5174
# Port of the stand-alone relay (server side, `bun run relay`). Hosts that set PORT are respected.
RELAY_PORT=5175
# Optional, server side: only pages from these origins may use the relay (comma separated).
RELAY_ALLOWED_ORIGINS=

# ---------- Contracts on Arc Testnet (public addresses) ----------
VITE_SKINS_ADDRESS=
VITE_BOOSTS_ADDRESS=
VITE_BOXES_ADDRESS=
VITE_MARKET_ADDRESS=
VITE_VRF_COORDINATOR=
VITE_DESCENT_ADDRESS=

# ---------- Server only: NEVER prefix with VITE_, never commit ----------
# Private key of the server wallet that signs Endless Descent tickets and reports finished runs.
DESCENT_OPERATOR_KEY=
